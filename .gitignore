# Rust workspace output. Cargo.lock is intentionally tracked because the
# CLI/server are applications rather than a reusable library distribution.
/target/

# Disposable v1 build/dependency outputs may remain in a long-lived checkout
# during the v2 cutover. They are never Rust release inputs.
/dist/
/node_modules/
/.stryker-tmp/
/.flake-log
/__tests__/evaluation/results/

# Native archive staging produced by the Rust release scripts.
release/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Test coverage
/coverage/

# SonarQube scanner working directory
/.scannerwork/

# Environment
.env
.env.local
.env.*.local

# Local v2 database credentials written by future `codevetra db start`
# lifecycle commands. The checked-in `.env.example` remains public.
/deploy/paradedb/.env

# Logs
*.log

# Local Claude settings
.claude/settings.local.json

# Local MCP server config — typically contains machine-specific
# absolute paths (e.g. --project-path) and shouldn't be shared.
.mcp.json

# CodeVetra data directories (in test projects)
.codevetra/

# Local archive of stale design docs / session memos — kept on disk
# for reference but never pushed.
docs/archive/
CLAUDE.local.md
AGENTS.local.md
.claude/skills/codevetra/SKILL.md
.codex/config.toml
.codex/skills/codevetra/SKILL.md
# CodeVetra private agent configuration
/.codex/config.toml
/.codex/skills/codevetra/SKILL.md
/.claude/settings.local.json
/.claude/skills/codevetra/SKILL.md
/CLAUDE.local.md
/.mcp.json
/.kimi-code/mcp.json

# Legacy private state and maintainer skills retained through the v4 transition.
.cartograph/
.cartograph
.claude/skills/cartograph/
.codex/skills/cartograph/

/.codex/skills/codevetra-release/
/.codex/skills/codevetra-extractors/
